# Variáveis do docker compose. Copie para .env na raiz do repositório e preencha.
# Gere valores aleatórios com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Obrigatório. Assina os tokens de login.
JWT_SECRET=

# Obrigatório. Cifra as chaves pessoais do Gemini no banco. Trocar depois invalida as já salvas.
LLM_KEY_ENCRYPTION_SECRET=

# IA gratuita para quem não cadastrou chave própria (console.groq.com/keys, sem cartão)
GROQ_API_KEY=

# Opcionais: modelos de IA
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-3.5-flash
