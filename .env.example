# Variáveis lidas pelo docker compose (copie para .env na raiz do repositório).

# IA gratuita para quem não cadastrou chave própria (console.groq.com/keys, sem cartão)
GROQ_API_KEY=

# Cifra as chaves pessoais do Gemini no banco. Use um valor longo e aleatório.
# Trocar depois invalida as chaves já salvas.
LLM_KEY_ENCRYPTION_SECRET=troque-por-um-valor-longo-e-aleatorio
