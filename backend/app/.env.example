# IA gratuita usada por quem não cadastrou chave própria (console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Chave pessoal do Gemini: cada usuário cadastra a sua em PUT /users/me/llm-key.
# Este segredo cifra essas chaves no banco. Trocar o valor invalida as já salvas.
LLM_KEY_ENCRYPTION_SECRET=change-me-to-a-long-random-value
GEMINI_MODEL=gemini-3.5-flash

# Assina os tokens de login. Use um valor longo e aleatório.
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio

# Banco de dados: PostgreSQL. Suba só o banco com `docker compose up -d db`.
DATABASE_URL=postgresql+asyncpg://sina:sina_secret@localhost:5432/sina_ia

# Ambiente (development, staging, production)
ENVIRONMENT=development
