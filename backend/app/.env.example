# Configuração da Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Banco de Dados (PostgreSQL para produção/desenvolvimento via Docker)
DATABASE_URL=postgresql+asyncpg://sina:sina_secret@localhost:5432/sina_ia

# Alternativa SQLite para desenvolvimento rápido sem Docker
# DATABASE_URL=sqlite+aiosqlite:///./study_platform.db

# Ambiente (development, staging, production)
ENVIRONMENT=development
