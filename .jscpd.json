{
  "threshold": 5,
  "reporters": ["html", "console", "json"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/__pycache__/**",
    "**/.venv/**",
    "**/coverage/**",
    "**/reports/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "**/dist/**",
    "**/htmlcov/**",
    "**/*.json",
    "**/*.lock"
  ],
  "absolute": true
}
